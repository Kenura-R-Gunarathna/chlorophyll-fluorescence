{
    "name": "lgplot",
    "version": "0.1.0",
    "description": "ImGui-based CCD spectrum plotting application with GLFW and OpenGL3",
    "dependencies": [
        "glfw3",
        "opengl",
        {
            "name": "imgui",
            "features": [
                "glfw-binding",
                "opengl3-binding",
                "docking-experimental"
            ]
        },
        "implot"
    ]
}